VITE_BASE_PATH=/

# DEFAULT: endpoint AI terpusat di Cloudflare Worker.
VITE_AI_CHAT_API_URL=https://api.rizam.fun/openai/portfolio-chat

# FALLBACK API ASLI CLOUDFLARE PAGES:
# VITE_AI_CHAT_API_URL=https://portofolio-72b.pages.dev/api/chat

# Variable berikut hanya dibutuhkan jika fallback /api/chat lama dipakai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_ALLOWED_ORIGINS=https://portofolio-72b.pages.dev,https://rizam.fun,https://www.rizam.fun,https://portfolio.rizam.fun,https://rizqizamzamijamil.github.io
OPENAI_DAILY_TOKEN_LIMIT=50000
OPENAI_DAILY_REQUEST_LIMIT=100
OPENAI_DAILY_IP_TOKEN_LIMIT=12000
OPENAI_DAILY_IP_REQUEST_LIMIT=30
OPENAI_MAX_OUTPUT_TOKENS=550
AI_RATE_LIMIT_TIMEZONE=Asia/Jakarta
